{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "postinstall": "bunx --bun prisma generate",
    "lint": "eslint --config ../eslint.config.js .",
    "lint:fix": "eslint --config ../eslint.config.js . --fix",
    "format": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check .",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:migrate:deploy": "bunx --bun prisma migrate deploy",
    "prisma:push": "bunx --bun prisma db push",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:studio": "bunx --bun prisma studio",
    "prisma:reset": "bunx --bun prisma migrate reset"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@clerk/express": "^2.1.63",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firecrawl": "^4.30.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "langsmith": "^0.9.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "svix": "^2.1.0",
    "tsx": "^4.23.0",
    "zod": "^4.4.3"
  }
}
