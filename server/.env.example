# ============================================
# AI Study Buddy - server environment variables
# Copy to `.env` (or `.env.development`) and fill in real values.
# ============================================

# --- HTTP server ---
PORT=3000

# --- Database (Postgres via docker compose) ---
# For VPS self-host (docker-compose.yml): set these + DATABASE_URL. See .env.production example.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=studybuddy
DATABASE_URL=postgresql://myuser:mypassword@postgres:5432/studybuddy

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Svix signing secret for /webhooks/clerk (user.deleted → data purge).
CLERK_WEBHOOK_SECRET=


# --- LangSmith tracing (optional; read natively by the LangChain SDKs) ---
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=StudyBuddy

# --- OpenAI (platform.openai.com) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RevenueCat ---
# Secret key (sk_...) for server-side entitlement checks. Optional in local dev.
REVENUECAT_SECRET_API_KEY=

# --- Firecrawl (firecrawl.dev) ---
# Used to scrape text from web sources.
FIRECRAWL_API_KEY=

# --- Cloudflare R2 object storage ---
# Cloudflare R2 S3-compatible storage. R2_ENDPOINT is optional unless using
# a jurisdiction endpoint; the default is https://ACCOUNT_ID.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Redis (required: rate limiting + BullMQ background jobs) ---
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# For docker compose with password: REDIS_URL=redis://:mypassword@redis:6379

# --- Logging (debug | info | warn | error) ---
LOG_LEVEL=info
